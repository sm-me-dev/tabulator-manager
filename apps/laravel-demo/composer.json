{
  "name": "apps/laravel-demo",
  "type": "project",
  "description": "Minimal Dockerized Laravel 12 API service for Render Free deployment",
  "license": "MIT",
  "require": {
    "php": "^8.2|^8.4",
    "laravel/framework": "^11.0|^12.0",
    "tabulator-manager/laravel": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/laravel",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
